---
import Base from "@/layouts/Base.astro";
import PaginaHero from "@/components/PaginaHero.astro";
import FranquiaCTA from "@/components/FranquiaCTA.astro";
import Icone from "@/components/Icone.astro";
import tsv from "@/data/unidades.tsv?raw";

const nomes: Record<string, string> = { AC: "Acre", AL: "Alagoas", AP: "Amapá", AM: "Amazonas", BA: "Bahia", CE: "Ceará", DF: "Distrito Federal", ES: "Espírito Santo", GO: "Goiás", MA: "Maranhão", MT: "Mato Grosso", MS: "Mato Grosso do Sul", MG: "Minas Gerais", PA: "Pará", PB: "Paraíba", PR: "Paraná", PE: "Pernambuco", PI: "Piauí", RJ: "Rio de Janeiro", RN: "Rio Grande do Norte", RS: "Rio Grande do Sul", RO: "Rondônia", RR: "Roraima", SC: "Santa Catarina", SP: "São Paulo", SE: "Sergipe", TO: "Tocantins" };
const contagem = new Map<string, number>();
for (const linha of tsv.trim().split("\n").slice(1)) {
  const uf = (linha.split("\t")[4] || "").trim().toUpperCase();
  if (uf) contagem.set(uf, (contagem.get(uf) || 0) + 1);
}
const total = [...contagem.values()].reduce((a, b) => a + b, 0);
const estados = [...contagem.entries()].map(([uf, n]) => ({ uf, nome: nomes[uf] || uf, n })).sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));
const qtdEstados = estados.filter((e) => e.uf !== "DF").length;
const sugestoes = ["São Paulo", "Santa Catarina", "Minas Gerais", "Brasília", "Rio de Janeiro"];
---
<Base titulo="Nossas unidades | Lavô" descricao="Encontre a Lavô mais próxima: busque por cidade, bairro, estado ou CEP e trace a rota no Google Maps ou no Waze.">
  <PaginaHero eyebrow="Nossas unidades" titulo="A roxinha mais amada está presente em *todo o país!*" texto="Somos a maior rede de lavanderias self-service do Brasil, com presença nacional e em breve na Europa. Abrimos uma loja nova a cada 36 horas." ondaCor="fill-nevoa" />

  <section class="bg-nevoa pt-10 pb-20 sm:pt-14 sm:pb-28">
    <div class="container-lavo">
      <div id="lavo-store-locator" class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
        <div class="flex flex-col rounded-[32px] border border-roxo/12 bg-white p-5 shadow-suave sm:p-8 lg:min-h-[660px]" data-anim="esquerda">
          <span class="eyebrow">Encontre uma unidade</span>
          <h2 class="text-[clamp(1.5rem,2.4vw,2rem)] font-extrabold">Encontre a Lavô mais próxima</h2>
          <p class="mt-1 mb-5 text-[0.97rem] text-tinta-suave">Digite seu endereço, CEP, cidade ou estado para encontrar a rota no Google Maps ou no Waze.</p>
          <label class="mb-2 block font-titulo text-[0.82rem] font-bold text-roxo" for="lavo-input-busca">Buscar por logradouro, bairro, cidade, estado ou CEP:</label>
          <div class="relative">
            <span class="pointer-events-none absolute top-1/2 left-4.5 -translate-y-1/2 text-roxo"><Icone nome="busca" class="size-5" /></span>
            <input id="lavo-input-busca" type="search" autocomplete="off" maxlength="80" placeholder="Ex.: Blumenau, Moema, SP ou 04088-003"
              class="h-14.5 w-full rounded-full border-2 border-roxo/12 bg-nevoa pr-5 pl-12.5 text-base text-tinta outline-none transition-[border-color,background-color,box-shadow] focus:border-roxo focus:bg-white focus:shadow-[0_0_0_5px_rgb(190_148_255/0.3)]" />
          </div>
          <div class="mt-3 flex flex-wrap gap-2" aria-label="Buscas rápidas">
            {sugestoes.map((s) => <button type="button" data-lavo-sugestao={s} class="rounded-full border border-roxo/12 bg-white px-3.5 py-1.5 font-titulo text-[0.82rem] font-semibold text-roxo transition-colors hover:border-roxo hover:bg-roxo hover:text-white">{s}</button>)}
          </div>
          <div class="mt-6 mb-3.5 flex min-h-6 items-center justify-between gap-3">
            <span id="lavo-contador" class="font-titulo font-extrabold text-roxo" aria-live="polite">+{total} unidades encontradas</span>
            <span id="lavo-status" class="text-[0.82rem] text-anil" aria-live="polite"></span>
          </div>
          <ul id="lavo-lista-cards" class="grid flex-1 content-start gap-2.5" aria-label="Unidades encontradas"></ul>
          <div class="mt-4.5 flex items-center justify-between gap-2.5 border-t border-roxo/12 pt-4.5">
            <button type="button" id="lavo-btn-prev" class="min-h-10.5 rounded-full border-2 border-roxo px-4.5 font-titulo text-sm font-bold text-roxo transition-colors enabled:hover:bg-roxo enabled:hover:text-white disabled:cursor-not-allowed disabled:opacity-35">← Anterior</button>
            <span id="lavo-info-pagina" class="text-sm font-semibold text-tinta-suave">Página 1</span>
            <button type="button" id="lavo-btn-next" class="min-h-10.5 rounded-full border-2 border-roxo px-4.5 font-titulo text-sm font-bold text-roxo transition-colors enabled:hover:bg-roxo enabled:hover:text-white disabled:cursor-not-allowed disabled:opacity-35">Próxima →</button>
          </div>
        </div>

        <div id="lavo-mapa" class="relative order-first h-[420px] overflow-hidden rounded-[32px] border-[6px] border-white bg-lilas-claro shadow-forte lg:sticky lg:top-24 lg:order-none lg:h-[min(78vh,720px)]" data-anim="direita">
          <div class="flex size-full flex-col items-center justify-center gap-4 p-8 text-center">
            <span class="grid size-16 place-items-center rounded-full bg-white text-roxo shadow-suave"><Icone nome="mapa" class="size-8" /></span>
            <h3 class="text-xl font-bold text-roxo">Mapa das unidades</h3>
            <p class="max-w-sm text-sm text-tinta-suave">O mapa é fornecido pelo Google, que pode coletar dados de navegação. Ele só é carregado com a sua permissão.</p>
            <button type="button" id="lavo-carregar-mapa" class="btn btn-roxo">Carregar mapa do Google</button>
            <a class="text-sm font-semibold text-roxo underline" href="/cookies">Como usamos ferramentas de terceiros</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark bg-roxo-escuro py-20 text-white sm:py-28">
    <div class="container-lavo">
      <div class="mb-10 max-w-3xl">
        <span class="eyebrow" data-anim="sobe">Presença nacional</span>
        <h2 class="text-[clamp(2rem,4.2vw,3.4rem)] leading-[1.08] font-extrabold" data-anim="sobe"><span data-contar={total}>{total}</span> lojas em {qtdEstados} estados e no Distrito Federal.</h2>
        <p class="mt-3 text-white/75" data-anim="sobe">Toque em um estado para ver as unidades.</p>
      </div>
      <ul class="flex flex-wrap gap-2" data-cascata="25">
        {estados.map((e) => (
          <li data-anim="zoom"><a href="#lavo-store-locator" data-lavo-sugestao={e.nome} class="group inline-flex items-baseline gap-1.5 rounded-full bg-white/10 px-3.5 py-2 font-titulo text-[0.9rem] font-bold text-white no-underline transition-colors hover:bg-lima hover:text-roxo-noite">{e.nome} <small class="font-semibold text-lima group-hover:text-roxo">{e.n}</small></a></li>
        ))}
      </ul>
    </div>
  </section>

  <FranquiaCTA />
</Base>

<script>
  import "@/scripts/localizador";
</script>
