---
/**
 * "Como funciona" — narrativa em duas metades guiada pela rolagem (GSAP ScrollTrigger).
 * Esquerda: o texto de cada etapa aparece conforme a rolagem. Direita: a máquina executa a etapa.
 * Sem JavaScript ou com movimento reduzido: tudo visível, em lista, com a ilustração estática.
 */
import Icone from "./Icone.astro";
import MaquinaRealista from "./MaquinaRealista.astro";

const etapas = [
  { rotulo: "01", titulo: "Meça as roupas", texto: "Use o cesto medidor para saber quanto cabe em cada ciclo. A marca de MÁX mostra o volume ideal para a lavagem render.", icone: "cesto" },
  { rotulo: "02", titulo: "Pague no totem", texto: "Pagamento rápido no totem de autoatendimento, sem atendente e sem fila. Aproximou o cartão, a máquina é liberada.", icone: "cartao" },
  { rotulo: "03", titulo: "Coloque na máquina", texto: "Máquinas Speed Queen de uso profissional, prontas para grandes volumes. Coloque as peças no tambor e feche a porta.", icone: "maquina" },
  { rotulo: "04", titulo: "Escolha o ciclo", texto: "Selecione o tipo de lavagem ou de secagem ideal para suas peças. O tempo aparece no visor.", icone: "toque" },
  { rotulo: "05", titulo: "Pressione INICIAR", texto: "Sabão e amaciante entram automaticamente, na medida certa. É só esperar.", icone: "play" },
  { rotulo: "35 min", titulo: "Lavando", texto: "Água e espuma tomam conta do tambor, que gira e acelera até a centrifugação.", icone: "gota" },
  { rotulo: "45 min", titulo: "Secando", texto: "Ar quente seca tudo de uma vez. Enquanto isso, aproveite para resolver outras coisas.", icone: "brilho" },
] as const;
---
<section id="como-funciona" class="ciclo relative bg-nevoa" data-ciclo aria-labelledby="titulo-como-funciona">
  <div class="ciclo-palco" data-palco>
    <div class="container-lavo ciclo-grade">
      <!-- ===== Metade do texto ===== -->
      <div class="ciclo-texto">
        <span class="eyebrow">Como funciona</span>
        <h2 id="titulo-como-funciona" class="ciclo-h2" data-titulo-ciclo>Cinco passos e sua roupa já está <span class="sublinhado is-visible">girando.</span></h2>

        <ol class="ciclo-trilha" aria-hidden="true" data-trilha>
          {etapas.map((e, i) => <li data-ponto={i}><span>{i < 5 ? e.rotulo : e.titulo}</span></li>)}
        </ol>

        <div class="ciclo-paineis" data-paineis>
          {etapas.map((e, i) => (
            <article class="ciclo-painel" data-painel={i}>
              <div class="flex items-center gap-4">
                <span class:list={["ciclo-painel-icone", i === 4 && "ciclo-painel-icone--play"]}>
                  {i === 4 ? (
                    <button type="button" class="grid size-full place-items-center rounded-full" data-iniciar aria-label="Pressionar INICIAR e assistir à lavagem e à secagem">
                      <Icone nome="play" class="size-8" />
                    </button>
                  ) : <Icone nome={e.icone} class="size-7" />}
                </span>
                <span class="ciclo-painel-rotulo">{i < 5 ? `Passo ${e.rotulo}` : `Cerca de ${e.rotulo}`}</span>
              </div>
              <h3 class="ciclo-painel-titulo" data-split>{e.titulo}</h3>
              <p class="ciclo-painel-texto">{e.texto}</p>
              {i === 4 && <p class="ciclo-dica" data-dica>Toque no play ou continue rolando.</p>}
            </article>
          ))}
        </div>

        <div class="ciclo-pilulas">
          <div class="ciclo-pilula" data-pilula role="progressbar" aria-label="Lavagem: cerca de 35 minutos" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="ciclo-pilula-barra" data-barra-pilula></span>
            <span class="relative flex items-center gap-2"><Icone nome="relogio" class="size-4.5" />Lavagem: cerca de 35 min</span>
            <span class="relative font-mono tabular-nums" data-tempo>35:00</span>
          </div>
          <div class="ciclo-pilula" data-pilula role="progressbar" aria-label="Secagem: cerca de 45 minutos" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="ciclo-pilula-barra" data-barra-pilula></span>
            <span class="relative flex items-center gap-2"><Icone nome="gota" class="size-4.5" />Secagem: cerca de 45 min</span>
            <span class="relative font-mono tabular-nums" data-tempo>45:00</span>
          </div>
        </div>
        <a href="/unidades" class="btn btn-roxo ciclo-cta" data-cta>Pronto! Encontrar uma unidade <Icone nome="pin" /></a>
      </div>

      <!-- ===== Metade da animação ===== -->
      <div class="ciclo-cena" data-cena>
        <div class="ciclo-cena-fundo" aria-hidden="true"></div>
        <MaquinaRealista />
      </div>
    </div>
  </div>
</section>

<script>
  import "@/scripts/ciclo";
</script>
