---
/** Onda de água animada na base de seções (cor = cor da próxima seção) */
interface Props { cor?: string }
const { cor = "fill-white" } = Astro.props;
---
<div class="pointer-events-none absolute inset-x-0 -bottom-px h-[clamp(40px,6vw,90px)] overflow-hidden" aria-hidden="true">
  <svg class:list={["absolute bottom-0 h-full w-[200%] animate-onda opacity-50", cor]} viewBox="0 0 2880 90" preserveAspectRatio="none">
    <path d="M0 50c240 30 480 30 720 0s480-30 720 0 480 30 720 0 480-30 720 0v40H0z" />
  </svg>
  <svg class:list={["absolute bottom-0 h-full w-[200%] animate-onda [animation-duration:18s]", cor]} viewBox="0 0 2880 90" preserveAspectRatio="none">
    <path d="M0 60c240-30 480-30 720 0s480 30 720 0 480-30 720 0 480 30 720 0v30H0z" />
  </svg>
</div>
