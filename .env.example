# Copie para .env e preencha
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

LAVO_MODELOS=claude-opus-5-5,claude-sonnet-5-5
LAVO_MODELO_AUXILIAR=claude-haiku-5-5
LAVO_ESFORCO=medium
LAVO_EMBEDDINGS=auto
LAVO_LIMITE_HISTORICO=60000
LAVO_MAX_PASSOS=8
LAVO_GUARDRAIL_LLM=0
LAVO_TOP_K=4

# ---------- CRM (crm/) ----------
# Gateway do WhatsApp (whatsapp-gateway/). Sem URL o CRM roda em modo SIMULADO.
WHATSAPP_GATEWAY_URL=http://localhost:3001
# Mesmo valor nos dois lados (CRM e gateway). Gere com: python3 -c "import secrets;print(secrets.token_hex(24))"
WHATSAPP_GATEWAY_TOKEN=
# Onde ficam banco SQLite e segredo das sessões (padrão: .crm/)
# CRM_DADOS=.crm
# Postgres em produção (opcional): CRM_BANCO=postgresql+psycopg://usuario:senha@host/lavo
# Ligue em produção, atrás de HTTPS:
CRM_COOKIE_SEGURO=0
