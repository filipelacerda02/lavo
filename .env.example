# Copie para .env e preencha
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

LAVO_MODELOS=claude-opus-5-5,claude-sonnet-5-5
LAVO_MODELO_AUXILIAR=claude-haiku-5-5
LAVO_ESFORCO=medium
LAVO_EMBEDDINGS=auto
LAVO_LIMITE_HISTORICO=60000
LAVO_MAX_PASSOS=8
LAVO_GUARDRAIL_LLM=0
LAVO_TOP_K=4

# ---------- CRM (crm/) ----------
# WhatsApp Business Platform — Cloud API oficial da Meta. Sem WHATSAPP_TOKEN o CRM roda em modo SIMULADO.
WHATSAPP_PROVEDOR=cloud
# Token permanente de um usuário do sistema (Gerenciador de Negócios) com as permissões
# whatsapp_business_messaging e whatsapp_business_management
WHATSAPP_TOKEN=
# Em WhatsApp > Configuração da API no app da Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Configurações do app > Básico > Chave secreta do app (valida a assinatura dos webhooks)
WHATSAPP_APP_SECRET=
# Texto que você escolhe; informe o mesmo ao cadastrar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0

# Onde ficam banco SQLite, mídias e segredo das sessões (padrão: .crm/)
# CRM_DADOS=.crm
# Postgres em produção (opcional): CRM_BANCO=postgresql+psycopg://usuario:senha@host/lavo
# Ligue em produção, atrás de HTTPS (o webhook da Meta exige HTTPS):
CRM_COOKIE_SEGURO=0
