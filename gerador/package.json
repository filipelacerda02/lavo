{
  "name": "reforma-gerador-de-sites",
  "version": "1.0.0",
  "private": true,
  "description": "Recebe a URL de um site, gera uma versão redesenhada com Claude, mostra prévia protegida e vende o código.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "cheerio": "1.2.0",
    "express": "4.22.3",
    "image-size": "2.1.0",
    "jszip": "3.10.2",
    "playwright": "1.63.0",
    "undici": "8.12.4"
  }
}
