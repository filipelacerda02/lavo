# ===== Obrigatórias em produção =====
# Chave da API da Anthropic (console.anthropic.com). Cobrança por uso, separada da assinatura do Claude.
ANTHROPIC_API_KEY=
# Access token do Mercado Pago (Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=
# Endereço público do site, sem barra no final (usado nos links de retorno do pagamento e no webhook)
BASE_URL=http://localhost:3000

# ===== Opcionais =====
PORT=3000
# Nome da marca exibido no site
NOME_PRODUTO=Reforma
# Preço em reais
PRECO=499.90
# Modelo e esforço da geração
MODELO=claude-opus-5-5
ESFORCO=high
# Limites para controlar o custo com IA
LIMITE_POR_IP_DIA=2
LIMITE_GLOBAL_DIA=150
# Reaproveita a prévia de um mesmo domínio por N dias (não gera de novo)
CACHE_DIAS=7
# Cotação usada para estimar custo em reais no painel
COTACAO_DOLAR=5.60
# Chave secreta do webhook do Mercado Pago (Suas integrações > Webhooks), para validar assinatura
MP_WEBHOOK_SECRET=
# Cloudflare Turnstile (anti-robô). Se vazio, o desafio fica desligado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Senha do painel /admin
ADMIN_SENHA=
# Pasta onde ficam os projetos gerados
PASTA_DADOS=./dados
# 1 = não chama a IA; gera uma página simples a partir do conteúdo extraído (para testar o fluxo)
MODO_DEMO=0
