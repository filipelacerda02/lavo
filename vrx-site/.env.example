# Variáveis públicas usadas no build (PUBLIC_* aparecem no navegador; nunca coloque segredos aqui)
SITE_URL=https://vrxequipamentos.com.br
# Cloudflare Turnstile (anti-robô dos formulários de orçamento e LGPD)
PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 (carrega só depois do consentimento "Analíticos")
PUBLIC_GA_ID=
# Meta Pixel (carrega só depois do consentimento "Marketing")
PUBLIC_META_PIXEL_ID=
# Sentry (monitoramento de erros, sem dados pessoais)
PUBLIC_SENTRY_DSN=
