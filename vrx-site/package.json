{
  "name": "vrx-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site da VRX Laundry Supply: Astro (SSG) + TypeScript + Tailwind, com funções na borda (Cloudflare Pages).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/verificar-build.mjs",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "check:functions": "tsc -p functions/tsconfig.json",
    "deploy": "npm run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@sentry/browser": "^11.18.0",
    "astro": "7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261125.1",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.168.0"
  }
}
