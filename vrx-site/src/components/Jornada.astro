---
/**
 * "Da escolha à lavanderia funcionando": narrativa em duas metades guiada pela rolagem (GSAP ScrollTrigger).
 * Um lado mostra o texto de cada etapa; o outro, a ilustração da loja executando a etapa.
 * No celular: texto em cima, ilustração embaixo. Sem JavaScript ou com movimento reduzido: tudo visível,
 * em lista, com a ilustração estática da loja pronta.
 * Todos os textos vêm do site atual da VRX (produtos, "Porque comprar de nós" e FAQ).
 */
import Icone from "./Icone.astro";
import Catavento from "./Catavento.astro";
import LojaIlustracao from "./LojaIlustracao.astro";

const etapas = [
  { curto: "Escolha", titulo: "Escolha seus equipamentos", texto: "Lavadoras e secadoras Speed Queen de nível industrial, projetadas para uso intenso e contínuo: mais durabilidade e menos paradas para manutenção.", icone: "lista" },
  { curto: "Orçamento", titulo: "Peça seu orçamento", texto: "Fale com a VRX pelo WhatsApp ou pelo formulário do site e conte quais equipamentos você quer para a sua lavanderia.", icone: "documento" },
  { curto: "Ponto", titulo: "Prepare o ponto", texto: "A infraestrutura da loja é do proprietário, mas você conta com um material de apoio criado por uma empresa de engenharia especializada em lavanderias.", icone: "planta" },
  { curto: "Instalação", titulo: "Equipamentos no lugar", texto: "Com água, energia e esgoto preparados, os equipamentos ficam prontos para a instalação correta no seu ponto comercial.", icone: "conjunto" },
  { curto: "Operação", titulo: "Lavanderia funcionando", texto: "Tecnologia que otimiza o consumo de água, energia e insumos: menos custos operacionais e mais competitividade no mercado.", icone: "grafico" },
  { curto: "Suporte", titulo: "Suporte e garantia", texto: "Técnicos autorizados em todas as regiões do país, com a Alliance do Brasil, e garantia de fábrica de 1 ano para mão de obra e 3 anos para peças.", icone: "escudo" },
] as const;
---
<section id="jornada" class="jornada relative bg-nevoa" data-jornada aria-labelledby="titulo-jornada">
  <div class="jornada-palco" data-palco>
    <div class="container-vrx jornada-grade">
      <!-- ===== Metade do texto ===== -->
      <div class="jornada-texto">
        <span class="eyebrow"><Catavento class="size-5" />Do pedido à porta aberta</span>
        <h2 id="titulo-jornada" class="jornada-h2">Da escolha à sua lavanderia <span class="sublinhado is-visible">funcionando.</span></h2>

        <ol class="jornada-trilha" aria-hidden="true">
          {etapas.map((e, i) => <li data-ponto={i}><span>{e.curto}</span></li>)}
        </ol>

        <div class="jornada-paineis">
          {etapas.map((e, i) => (
            <article class="jornada-painel" data-painel={i}>
              <div class="flex items-center gap-4">
                <span class="jornada-painel-icone"><Icone nome={e.icone} class="size-7" /></span>
                <span class="jornada-painel-rotulo">Etapa {String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="jornada-painel-titulo" data-split>{e.titulo}</h3>
              <p class="jornada-painel-texto">{e.texto}</p>
            </article>
          ))}
        </div>
        <a href="/orcamento" class="btn btn-laranja jornada-cta" data-cta>Pedir meu orçamento <Icone nome="seta" /></a>
      </div>

      <!-- ===== Metade da ilustração ===== -->
      <div class="jornada-cena">
        <div class="jornada-cena-fundo" aria-hidden="true"></div>
        <LojaIlustracao />
      </div>
    </div>
  </div>
</section>

<script>
  import "@/scripts/jornada";
</script>
