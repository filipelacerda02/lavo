---
import Base from "@/layouts/Base.astro";
import Icone from "@/components/Icone.astro";
import Catavento from "@/components/Catavento.astro";
---
<Base titulo="Página não encontrada | VRX Laundry Supply" descricao="A página que você procura não existe." semIndice>
  <section class="relative grid min-h-[70vh] place-items-center overflow-hidden bg-nevoa px-4 py-24 text-center">
    <div class="pointer-events-none absolute top-1/2 left-1/2 size-[560px] -translate-1/2 text-cinza" aria-hidden="true"><Catavento class="size-full animate-giro" laranja="#f9e0cd" /></div>
    <div class="relative">
      <p class="font-titulo text-[clamp(5rem,18vw,11rem)] leading-none font-bold text-laranja-escuro" data-anim="zoom">404</p>
      <h1 class="mt-2 text-3xl font-bold text-grafite-noite" data-anim="sobe">Essa página saiu do catálogo.</h1>
      <p class="mt-3 text-tinta-suave" data-anim="sobe">Confira o endereço ou volte para o início.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3" data-anim="sobe">
        <a class="btn btn-laranja" href="/">Voltar ao início <Icone nome="seta" /></a>
        <a class="btn btn-contorno" href="/produtos">Ver produtos</a>
      </div>
    </div>
  </section>
</Base>
